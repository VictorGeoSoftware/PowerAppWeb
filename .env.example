# Server-only. BmBackend origin without /api/v1.
# Local Docker QA stack (../BmInfra/bm-local-qa up): http://localhost:9081  (recommended on corporate network)
# Remote QA VPS: http://217.154.181.175:9081
BM_BACKEND_URL=http://localhost:9081

# Firebase web app config (public client values, inlined at build time).
# Get them from Firebase console > Project settings > Your apps > PowerAppWeb.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
